# =============================================================================
# JS-CMS Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values
# cp .env.example .env

# =============================================================================
# Database Configuration
# =============================================================================

# For local development (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# For production (PostgreSQL) - Use Vercel Postgres or external provider
# DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# =============================================================================
# Docker Deployment Configuration
# =============================================================================
# These variables are required when using Docker Compose

# Database password for PostgreSQL (used in docker-compose.yml)
# Generate a strong password for production!
# You can generate one with: openssl rand -base64 32
DB_PASSWORD="changeme123"

# =============================================================================
# Application Security
# =============================================================================

# JWT Secret - Generate a strong random string for production
# You can generate one with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# =============================================================================
# Google OAuth Configuration
# =============================================================================

# Get these from Google Cloud Console: https://console.cloud.google.com/
# Navigate to: APIs & Services > Credentials > Create OAuth 2.0 Client ID
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google OAuth Redirect URI (optional - will be auto-detected from request URL)
# For local development: http://localhost:3000/api/auth/callback/google
# For Docker (local): http://localhost:3000/api/auth/callback/google
# For production: https://your-domain.com/api/auth/callback/google
GOOGLE_REDIRECT_URI=""

# =============================================================================
# Environment Settings
# =============================================================================

# Node Environment
# Options: "development" | "production"
# For Docker, this is automatically set to "production" in docker-compose.yml
NODE_ENV="development"
